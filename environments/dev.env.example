# SIGA - ejemplo de variables. NO colocar valores reales en Git.
# Copiar a .env solo en desarrollo local y mantener .env en .gitignore.

SIGA_ENV=local
TZ=America/Lima

# API Gateway / URLs internas de Compose
IDENTITY_SERVICE_URL=http://identity-service:8080
CATALOG_SERVICE_URL=http://catalog-service:8080
INVENTORY_SERVICE_URL=http://inventory-service:8080
EVIDENCE_SERVICE_URL=http://evidence-service:8080
AUDIT_SERVICE_URL=http://audit-notification-service:8080
REPORTING_SERVICE_URL=http://reporting-analytics-service:8080

# PostgreSQL local. En cloud usar Secret Manager / Cloud SQL connector.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=siga
POSTGRES_USER=
POSTGRES_PASSWORD=

# Redis efímero: OTP/rate-limit/revocación/caché. Nunca autoridad de stock.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# Object storage local (MinIO). Producción: GCS por adaptador/configuración.
STORAGE_PROVIDER=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=siga-evidences
GCS_BUCKET=siga-evidences-prod
GCP_PROJECT_ID=

# JWT. La PRIVATE KEY existe únicamente en Identity. No copiarla a otros servicios.
JWT_PRIVATE_KEY_PATH=/run/secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=/run/secrets/jwt_public.pem
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# Seguridad baseline configurable
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
OTP_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Upload baseline configurable
MAX_IMAGE_MB=10
MAX_PDF_MB=20

# Observabilidad
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
